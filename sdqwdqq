				return Tab:Button(bcfg, holder)
			end
			function Section:Toggle(tcfg)
				return Tab:Toggle(tcfg, holder)
			end
			function Section:Slider(sc)
				return Tab:Slider(sc, holder)
			end
			function Section:Label(lcfg)
				return Tab:Label(lcfg, holder)
