-- [[ Full Undetected & Assetless Roblox UI Library ]]

local cloneref = cloneref or function(obj) return obj end

local Services = setmetatable({}, {
    __index = function(self, serviceName)
        local rawService = game:GetService(serviceName)
        if rawService then
            return cloneref(rawService)
        end
        return nil
    end
})

local UserInputService = Services.UserInputService
local TweenService = Services.TweenService
local RunService = Services.RunService
local CoreGui = Services.CoreGui
local Players = Services.Players

local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

local Library = {
    Themes = {
        Default = {
            MainBackground = Color3.fromRGB(20, 20, 20),
            SecondaryBackground = Color3.fromRGB(30, 30, 30),
            Accent = Color3.fromRGB(0, 140, 255),
            Text = Color3.fromRGB(255, 255, 255),
            SubText = Color3.fromRGB(160, 160, 160),
            Border = Color3.fromRGB(40, 40, 40)
        }
    },
    Shapes = {
        Circle = { Image = "", Rect = Rect.new(0, 0, 0, 0), Radius = 512 },
        Squircle = { Image = "", Rect = Rect.new(0, 0, 0, 0), Radius = 310 },
        Square = { Image = "", Rect = Rect.new(0, 0, 0, 0), Radius = 512 }
    }
}

function Library:Create(instanceType, properties, children)
    local obj = cloneref(Instance.new(instanceType))
    for prop, val in pairs(properties or {}) do
        obj[prop] = val
    end
    for _, child in ipairs(children or {}) do
        child.Parent = obj
    end
    return obj
end

function Library:MakeDraggable(gui, handle)
    local dragging = false
    local dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        gui.Position = UDim2.new(
            startPos.X.Scale, 
            startPos.X.Offset + delta.X, 
            startPos.Y.Scale, 
            startPos.Y.Offset + delta.Y
        )
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)
end

function Library:CreateWindow(titleText)
    local ScreenGui = Library:Create("ScreenGui", {
        Name = "UndetectedUI_" .. tostring(math.random(10000, 99999)),
        ResetOnSpawn = false,
        DisplayOrder = 999
    })

    -- Защищенная загрузка в контейнер
    if gethui then
        ScreenGui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(ScreenGui)
        ScreenGui.Parent = CoreGui
    else
        ScreenGui.Parent = CoreGui
    end

    local MainFrame = Library:Create("Frame", {
        Name = "MainFrame",
        Size = UDim2.new(0, 500, 0, 350),
        Position = UDim2.new(0.5, -250, 0.5, -175),
        BackgroundColor3 = Library.Themes.Default.MainBackground,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, {
        Library:Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
        Library:Create("UIStroke", {
            Color = Library.Themes.Default.Border,
            Thickness = 1
        })
    })
    MainFrame.Parent = ScreenGui

    local TopBar = Library:Create("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Library.Themes.Default.SecondaryBackground,
        BorderSizePixel = 0
    }, {
        Library:Create("UICorner", { CornerRadius = UDim.new(0, 8) }),
        Library:Create("TextLabel", {
            Name = "Title",
            Text = titleText or "UI Window",
            Font = Enum.Font.SourceSansBold,
            TextSize = 16,
            TextColor3 = Library.Themes.Default.Text,
            Size = UDim2.new(1, -50, 1, 0),
            Position = UDim2.new(0, 15, 0, 0),
            TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1
        })
    })
    TopBar.Parent = MainFrame

    Library:MakeDraggable(MainFrame, TopBar)

    local TabContainer = Library:Create("Frame", {
        Name = "TabContainer",
        Size = UDim2.new(0, 130, 1, -40),
        Position = UDim2.new(0, 0, 0, 40),
        BackgroundColor3 = Library.Themes.Default.SecondaryBackground,
        BorderSizePixel = 0
    })
    TabContainer.Parent = MainFrame

    local TabListLayout = Library:Create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 5)
    })
    TabListLayout.Parent = TabContainer

    local ContentContainer = Library:Create("Frame", {
        Name = "ContentContainer",
        Size = UDim2.new(1, -140, 1, -50),
        Position = UDim2.new(0, 135, 0, 45),
        BackgroundTransparency = 1
    })
    ContentContainer.Parent = MainFrame

    local Window = { CurrentTab = nil }

    function Window:CreateTab(tabName)
        local TabButton = Library:Create("TextButton", {
            Name = tabName .. "_Button",
            Size = UDim2.new(1, -10, 0, 30),
            Position = UDim2.new(0, 5, 0, 0),
            BackgroundColor3 = Library.Themes.Default.MainBackground,
            Text = tabName,
            TextColor3 = Library.Themes.Default.SubText,
            Font = Enum.Font.SourceSans,
            TextSize = 14,
            BorderSizePixel = 0,
            AutoButtonColor = false
        }, {
            Library:Create("UICorner", { CornerRadius = UDim.new(0, 4) })
        })
        TabButton.Parent = TabContainer

        local TabContent = Library:Create("ScrollingFrame", {
            Name = tabName .. "_Content",
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Visible = false,
            ScrollBarThickness = 2,
            CanvasSize = UDim2.new(0, 0, 0, 0)
        }, {
            Library:Create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 8)
            })
        })
        TabContent.Parent = ContentContainer

        TabContent.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabContent.CanvasSize = UDim2.new(0, 0, 0, TabContent.UIListLayout.AbsoluteContentSize.Y + 10)
        end)

        TabButton.MouseButton1Click:Connect(function()
            for _, child in ipairs(ContentContainer:GetChildren()) do
                if child:IsA("ScrollingFrame") then child.Visible = false end
            end
            for _, child in ipairs(TabContainer:GetChildren()) do
                if child:IsA("TextButton") then
                    child.TextColor3 = Library.Themes.Default.SubText
                    child.BackgroundColor3 = Library.Themes.Default.MainBackground
                end
            end
            TabContent.Visible = true
            TabButton.TextColor3 = Library.Themes.Default.Text
            TabButton.BackgroundColor3 = Library.Themes.Default.Accent
        end)

        if not Window.CurrentTab then
            Window.CurrentTab = TabContent
            TabContent.Visible = true
            TabButton.TextColor3 = Library.Themes.Default.Text
            TabButton.BackgroundColor3 = Library.Themes.Default.Accent
        end

        local Tab = {}

        function Tab:AddButton(btnText, callback)
            local Button = Library:Create("TextButton", {
                Size = UDim2.new(1, -5, 0, 32),
                BackgroundColor3 = Library.Themes.Default.SecondaryBackground,
                Text = btnText,
                TextColor3 = Library.Themes.Default.Text,
                Font = Enum.Font.SourceSansBold,
                TextSize = 14,
                BorderSizePixel = 0
            }, {
                Library:Create("UICorner", { CornerRadius = UDim.new(0, 4) })
            })
            Button.Parent = TabContent

            Button.MouseButton1Click:Connect(function()
                pcall(callback)
            end)
        end

        function Tab:AddToggle(toggleText, defaultState, callback)
            local state = defaultState or false
            local ToggleFrame = Library:Create("Frame", {
                Size = UDim2.new(1, -5, 0, 32),
                BackgroundColor3 = Library.Themes.Default.SecondaryBackground
            }, {
                Library:Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
                Library:Create("TextLabel", {
                    Text = toggleText,
                    Size = UDim2.new(1, -40, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),
                    TextColor3 = Library.Themes.Default.Text,
                    Font = Enum.Font.SourceSans,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1
                })
            })
            ToggleFrame.Parent = TabContent

            local Indicator = Library:Create("Frame", {
                Size = UDim2.new(0, 18, 0, 18),
                Position = UDim2.new(1, -28, 0.5, -9),
                BackgroundColor3 = state and Library.Themes.Default.Accent or Library.Themes.Default.MainBackground
            }, {
                Library:Create("UICorner", { CornerRadius = UDim.new(0, 4) })
            })
            Indicator.Parent = ToggleFrame

            local ClickArea = Library:Create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = ""
            })
            ClickArea.Parent = ToggleFrame

            ClickArea.MouseButton1Click:Connect(function()
                state = not state
                Indicator.BackgroundColor3 = state and Library.Themes.Default.Accent or Library.Themes.Default.MainBackground
                pcall(callback, state)
            end)
        end

        return Tab
    end

    return Window
end

return Library
