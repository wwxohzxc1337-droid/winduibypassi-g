			function Section:Space()
				make("Frame", {
					Size = UDim2.new(1, 0, 0, 4),
					BackgroundTransparency = 1,
					Parent = holder,
				})
			end
			return Section
		end

		function Tab:Button(bcfg, parent)
			bcfg = bcfg or {}
			local btn = make("TextButton", {
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundColor3 = bcfg.Color or theme.Accent,
				Text = bcfg.Title or "Button",
				TextColor3 = Color3.new(1, 1, 1),
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Parent = parent or page,
			}, {
				make("UICorner", { CornerRadius = UDim.new(0, 8) }),
			})
			btn.MouseEnter:Connect(function()
				tween(btn, 0.12, { BackgroundColor3 = theme.AccentHover })
			end)
			btn.MouseLeave:Connect(function()
				tween(btn, 0.12, { BackgroundColor3 = bcfg.Color or theme.Accent })
			end)
			btn.MouseButton1Click:Connect(function()
				if bcfg.Callback then
					pcall(bcfg.Callback)
				end
			end)
			local api = {}
			function api:SetTitle(t) btn.Text = t end
			function api:Destroy() btn:Destroy() end
			return api
		end

		function Tab:Toggle(tcfg, parent)
			tcfg = tcfg or {}
			local state = tcfg.Value or tcfg.Default or false
			local row = make("Frame", {
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundColor3 = theme.Bg,
				BorderSizePixel = 0,
				Parent = parent or page,
			}, {
				make("UICorner", { CornerRadius = UDim.new(0, 8) }),
			})
			make("TextLabel", {
				Size = UDim2.new(1, -60, 1, 0),
				Position = UDim2.new(0, 12, 0, 0),
				BackgroundTransparency = 1,
				Text = tcfg.Title or "Toggle",
				TextColor3 = theme.Text,
				TextSize = 13,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = row,
			})
			local track = make("Frame", {
				Size = UDim2.new(0, 40, 0, 22),
				Position = UDim2.new(1, -52, 0.5, -11),
				BackgroundColor3 = state and theme.ToggleOn or theme.ToggleOff,
				BorderSizePixel = 0,
				Parent = row,
			}, {
				make("UICorner", { CornerRadius = UDim.new(1, 0) }),
			})
			local knob = make("Frame", {
				Size = UDim2.new(0, 16, 0, 16),
				Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Parent = track,
			}, {
				make("UICorner", { CornerRadius = UDim.new(1, 0) }),
			})
			local click = make("TextButton", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				Text = "",
				Parent = row,
			})
			local function set(v)
				state = v
				tween(track, 0.15, { BackgroundColor3 = state and theme.ToggleOn or theme.ToggleOff })
				tween(knob, 0.15, {
					Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
				})
				if tcfg.Callback then
					pcall(tcfg.Callback, state)
				end
			end
			click.MouseButton1Click:Connect(function()
				set(not state)
			end)
			local api = {}
			function api:Set(v) set(v) end
			function api:Get() return state end
			function api:Destroy() row:Destroy() end
			return api
		end

		function Tab:Slider(scfg, parent)
			scfg = scfg or {}
			local min = (scfg.Value and scfg.Value.Min) or scfg.Min or 0
			local max = (scfg.Value and scfg.Value.Max) or scfg.Max or 100
			local default = (scfg.Value and scfg.Value.Default) or scfg.Default or min
			local step = scfg.Step or 1
			local value = default

			local row = make("Frame", {
				Size = UDim2.new(1, 0, 0, 52),
				BackgroundColor3 = theme.Bg,
				BorderSizePixel = 0,
				Parent = parent or page,
			}, {
				make("UICorner", { CornerRadius = UDim.new(0, 8) }),
			})
			local titleL = make("TextLabel", {
				Size = UDim2.new(1, -50, 0, 20),
				Position = UDim2.new(0, 12, 0, 6),
				BackgroundTransparency = 1,
				Text = scfg.Title or "Slider",
				TextColor3 = theme.Text,
				TextSize = 13,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = row,
			})
			local valL = make("TextLabel", {
				Size = UDim2.new(0, 40, 0, 20),
				Position = UDim2.new(1, -48, 0, 6),
				BackgroundTransparency = 1,
				Text = tostring(value),
				TextColor3 = theme.TextDim,
				TextSize = 12,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})
			local barBg = make("Frame", {
				Size = UDim2.new(1, -24, 0, 6),
				Position = UDim2.new(0, 12, 0, 34),
				BackgroundColor3 = theme.ToggleOff,
				BorderSizePixel = 0,
				Parent = row,
			}, {
				make("UICorner", { CornerRadius = UDim.new(1, 0) }),
			})
			local fill = make("Frame", {
				Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
				BackgroundColor3 = theme.Accent,
				BorderSizePixel = 0,
				Parent = barBg,
			}, {
				make("UICorner", { CornerRadius = UDim.new(1, 0) }),
			})

			local sliding = false
			local function update(x)
				local rel = math.clamp((x - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
				value = math.floor((min + (max - min) * rel) / step + 0.5) * step
				value = math.clamp(value, min, max)
				fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
				valL.Text = tostring(value)
				if scfg.Callback then
					pcall(scfg.Callback, value)
				end
			end
			barBg.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					update(input.Position.X)
				end
			end)
			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end)
			UIS.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					update(input.Position.X)
				end
			end)

			local api = {}
			function api:Set(v)
				value = math.clamp(v, min, max)
				fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
				valL.Text = tostring(value)
			end
			function api:Get() return value end
			function api:Destroy() row:Destroy() end
			return api
		end

		function Tab:Dropdown(dcfg, parent)
			dcfg = dcfg or {}
			local values = dcfg.Values or {}
			local selected = dcfg.Value
			local multi = dcfg.Multi
			local open = false

			local row = make("Frame", {
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundColor3 = theme.Bg,
				BorderSizePixel = 0,
				ClipsDescendants = false,
				ZIndex = 5,
				Parent = parent or page,
			}, {
				make("UICorner", { CornerRadius = UDim.new(0, 8) }),
			})
			local label = make("TextLabel", {
				Size = UDim2.new(1, -40, 1, 0),
				Position = UDim2.new(0, 12, 0, 0),
				BackgroundTransparency = 1,
				Text = dcfg.Title or "Dropdown",
				TextColor3 = theme.Text,
				TextSize = 13,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 6,
				Parent = row,
			})
			local arrow = make("TextLabel", {
				Size = UDim2.new(0, 24, 1, 0),
				Position = UDim2.new(1, -28, 0, 0),
				BackgroundTransparency = 1,
				Text = "▾",
				TextColor3 = theme.TextDim,
				TextSize = 12,
				Font = Enum.Font.Gotham,
				ZIndex = 6,
				Parent = row,
			})
			local listFrame = make("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				Position = UDim2.new(0, 0, 1, 4),
				BackgroundColor3 = theme.Panel,
				BorderSizePixel = 0,
				Visible = false,
				ZIndex = 20,
				ClipsDescendants = true,
				Parent = row,
			}, {
				make("UICorner", { CornerRadius = UDim.new(0, 8) }),
				make("UIStroke", { Color = theme.Stroke, Thickness = 1 }),
				make("UIListLayout", {
					Padding = UDim.new(0, 2),
					SortOrder = Enum.SortOrder.LayoutOrder,
				}),
				make("UIPadding", {
					PaddingTop = UDim.new(0, 4),
					PaddingBottom = UDim.new(0, 4),
				}),
			})

			local function refreshLabel()
				if multi and type(selected) == "table" then
					label.Text = (#selected > 0) and table.concat(selected, ", ") or (dcfg.Title or "Dropdown")
				elseif selected then
					label.Text = tostring(selected)
				else
					label.Text = dcfg.Title or "Dropdown"
				end
			end

			local function toggleList()
				open = not open
				listFrame.Visible = open
				if open then
					local h = math.min(#values * 28 + 8, 160)
					listFrame.Size = UDim2.new(1, 0, 0, h)
				else
					listFrame.Size = UDim2.new(1, 0, 0, 0)
				end
			end

			local click = make("TextButton", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				Text = "",
				ZIndex = 7,
				Parent = row,
			})
			click.MouseButton1Click:Connect(toggleList)

			local function rebuild()
				for _, ch in ipairs(listFrame:GetChildren()) do
					if ch:IsA("TextButton") then ch:Destroy() end
				end
				for _, v in ipairs(values) do
					local itemText = type(v) == "table" and (v.Title or tostring(v)) or tostring(v)
					local item = make("TextButton", {
						Size = UDim2.new(1, -8, 0, 26),
						Position = UDim2.new(0, 4, 0, 0),
						BackgroundColor3 = theme.Bg,
						BackgroundTransparency = 1,
						Text = "  " .. itemText,
						TextColor3 = theme.Text,
						TextSize = 12,
						Font = Enum.Font.Gotham,
						TextXAlignment = Enum.TextXAlignment.Left,
						BorderSizePixel = 0,
						AutoButtonColor = false,
						ZIndex = 21,
						Parent = listFrame,
					}, {
						make("UICorner", { CornerRadius = UDim.new(0, 6) }),
					})
					item.MouseEnter:Connect(function()
						item.BackgroundTransparency = 0.3
					end)
					item.MouseLeave:Connect(function()
						item.BackgroundTransparency = 1
					end)
					item.MouseButton1Click:Connect(function()
						if multi then
							selected = selected or {}
							local idx = table.find(selected, itemText)
							if idx then
								table.remove(selected, idx)
							else
								table.insert(selected, itemText)
							end
						else
							selected = itemText
							toggleList()
						end
						refreshLabel()
						if dcfg.Callback then
							pcall(dcfg.Callback, selected)
						end
					end)
				end
			end
			rebuild()
			refreshLabel()

			local api = {}
			function api:Refresh(newVals)
				values = newVals or values
				rebuild()
			end
			function api:Select(v)
				selected = v
				refreshLabel()
			end
			function api:Get() return selected end
			function api:Destroy() row:Destroy() end
			return api
		end

		function Tab:Input(icfg, parent)
			icfg = icfg or {}
			local row = make("Frame", {
				Size = UDim2.new(1, 0, 0, 36),
				BackgroundColor3 = theme.Bg,
				BorderSizePixel = 0,
				Parent = parent or page,
			}, {
				make("UICorner", { CornerRadius = UDim.new(0, 8) }),
			})
			local box = make("TextBox", {
				Size = UDim2.new(1, -20, 1, 0),
				Position = UDim2.new(0, 10, 0, 0),
				BackgroundTransparency = 1,
				Text = icfg.Value or "",
				PlaceholderText = icfg.Placeholder or icfg.Title or "Input",
				PlaceholderColor3 = theme.TextDim,
				TextColor3 = theme.Text,
				TextSize = 13,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false,
				Parent = row,
			})
			box.FocusLost:Connect(function(enter)
				if icfg.Callback then
					pcall(icfg.Callback, box.Text)
				end
			end)
			local api = {}
			function api:Set(t) box.Text = t end
			function api:Get() return box.Text end
			function api:Destroy() row:Destroy() end
			return api
		end

		function Tab:Label(lcfg, parent)
			lcfg = lcfg or {}
			local lbl = make("TextLabel", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Text = lcfg.Title or lcfg.Text or "",
				TextColor3 = theme.TextDim,
				TextSize = lcfg.TextSize or 13,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true,
				Parent = parent or page,
			})
			return { Destroy = function() lbl:Destroy() end }
		end

		function Tab:Paragraph(pcfg, parent)
			return Tab:Label(pcfg, parent)
		end

		function Tab:Space(scfg)
			local h = (scfg and scfg.Size) or 8
			make("Frame", {
				Size = UDim2.new(1, 0, 0, h),
				BackgroundTransparency = 1,
				Parent = page,
			})
		end

		function Tab:Divider()
			make("Frame", {
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = theme.Stroke,
				BackgroundTransparency = 0.5,
				BorderSizePixel = 0,
				Parent = page,
			})
		end

		return Tab
	end

	function Window:Section(scfg)
		-- sidebar section label
		scfg = scfg or {}
		make("TextLabel", {
			Size = UDim2.new(1, -8, 0, 22),
			BackgroundTransparency = 1,
			Text = scfg.Title or "",
			TextColor3 = theme.TextDim,
			TextSize = 11,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = tabList,
		}, {
			make("UIPadding", { PaddingLeft = UDim.new(0, 4) }),
		})
		-- returns object that can create tabs under visual group
		local sec = {}
		function sec:Tab(tcfg)
			return Window:Tab(tcfg)
		end
		return sec
	end

	-- open animation
	main.Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 0)
	task.defer(function()
		tween(main, 0.4, { Size = size })
	end)

	table.insert(Library.Windows, Window)
	return Window
end

return Library
