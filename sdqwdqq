			BackgroundTransparency = 1,
			Text = "",
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Parent = tabList,
		}, {
			make("UICorner", { CornerRadius = UDim.new(0, 8) }),
		})

		local tabLabel = make("TextLabel", {
			Size = UDim2.new(1, -12, 1, 0),
			Position = UDim2.new(0, 10, 0, 0),
			BackgroundTransparency = 1,
			Text = tabTitle,
			TextColor3 = theme.TextDim,
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = tabBtn,
		})

		local page = make("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = theme.Stroke,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
			Parent = content,
		}, {
			make("UIListLayout", {
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
			make("UIPadding", {
				PaddingTop = UDim.new(0, 14),
				PaddingBottom = UDim.new(0, 14),
				PaddingLeft = UDim.new(0, 14),
				PaddingRight = UDim.new(0, 14),
			}),
		})

		local Tab = {
			_btn = tabBtn,
			_page = page,
			_title = tabTitle,
		}

		local function selectTab()
			for _, t in pairs(Window._tabs) do
				t._page.Visible = false
				tween(t._btn, 0.15, { BackgroundTransparency = 1 })
				t._btn:FindFirstChildOfClass("TextLabel").TextColor3 = theme.TextDim
			end
			page.Visible = true
			tween(tabBtn, 0.15, { BackgroundTransparency = 0, BackgroundColor3 = theme.Panel })
			tabLabel.TextColor3 = theme.Text
			Window._selected = Tab
		end

		tabBtn.MouseButton1Click:Connect(selectTab)
		tabBtn.MouseEnter:Connect(function()
			if Window._selected ~= Tab then
				tween(tabBtn, 0.12, { BackgroundTransparency = 0.6, BackgroundColor3 = theme.Panel })
			end
		end)
		tabBtn.MouseLeave:Connect(function()
			if Window._selected ~= Tab then
				tween(tabBtn, 0.12, { BackgroundTransparency = 1 })
			end
		end)

		table.insert(Window._tabs, Tab)
		if #Window._tabs == 1 then
			selectTab()
		end

		-- elements
		local function addElement(container)
			return container or page
		end

		function Tab:Section(scfg)
			scfg = scfg or {}
			local holder = make("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Parent = page,
			}, {
