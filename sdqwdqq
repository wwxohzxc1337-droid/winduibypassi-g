function Library:Notify(cfg)
	cfg = cfg or {}
	local parent = getParent()
	local holder = parent:FindFirstChild("_nHold")
	if not holder then
		holder = make("ScreenGui", {
			Name = rnd(14),
			ResetOnSpawn = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			DisplayOrder = math.random(-50000, -1000),
			Parent = parent,
		})
		local list = make("Frame", {
			Name = "_nHold",
			Size = UDim2.new(0, 300, 1, -40),
			Position = UDim2.new(1, -320, 0, 20),
			BackgroundTransparency = 1,
			Parent = holder,
		})
		make("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Parent = list,
		})
	end
	local list = holder:FindFirstChild("_nHold") or holder:GetChildren()[1]
	local theme = Library.Theme
	local card = make("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Panel,
		BorderSizePixel = 0,
		Parent = list,
	}, {
		make("UICorner", { CornerRadius = UDim.new(0, 10) }),
		make("UIStroke", { Color = theme.Stroke, Thickness = 1, Transparency = 0.5 }),
		make("UIPadding", {
			PaddingTop = UDim.new(0, 12),
			PaddingBottom = UDim.new(0, 12),
			PaddingLeft = UDim.new(0, 14),
			PaddingRight = UDim.new(0, 14),
		}),
	})
	make("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = cfg.Title or "Notify",
		TextColor3 = theme.Text,
		TextSize = 15,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	if cfg.Content or cfg.Desc then
		make("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Text = cfg.Content or cfg.Desc or "",
			TextColor3 = theme.TextDim,
			TextSize = 13,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			Position = UDim2.new(0, 0, 0, 22),
			Parent = card,
		})
	end
	card.BackgroundTransparency = 1
	tween(card, 0.25, { BackgroundTransparency = 0 })
	task.delay(cfg.Duration or 3.5, function()
		if card and card.Parent then
			tween(card, 0.2, { BackgroundTransparency = 1 })
			task.wait(0.25)
			card:Destroy()
		end
	end)
end

function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local theme = Library.Theme
	local title = cfg.Title or rnd(6)
	local size = cfg.Size or UDim2.new(0, 580, 0, 420)
	local minSize = cfg.MinSize or Vector2.new(400, 280)

	local sg = make("ScreenGui", {
		Name = rnd(16),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = math.random(-90000, -5000),
		Parent = getParent(),
	})

	-- rename loop (anti simple name scan)
	task.spawn(function()
		while sg and sg.Parent do
			task.wait(math.random(20, 45))
			pcall(function() sg.Name = rnd(14) end)
		end
	end)

	local main = make("Frame", {
		Name = rnd(8),
		Size = size,
		Position = UDim2.new(0.5, -size.X.Offset / 2, 0.5, -size.Y.Offset / 2),
		BackgroundColor3 = theme.Bg,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = sg,
	}, {
		make("UICorner", { CornerRadius = UDim.new(0, 14) }),
		make("UIStroke", { Color = theme.Stroke, Thickness = 1, Transparency = 0.4 }),
	})

	-- topbar
